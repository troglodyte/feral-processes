{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false
  },
  "skillOverrides": {
    "kotlin-mcp-server-generator": "off",
    "stripe-best-practices": "off",
    "vercel-composition-patterns": "off",
    "vercel-react-best-practices": "off",
    "vercel-react-view-transitions": "off",
    "web-design-guidelines": "off",
    "dataviz": "off",
    "claude-in-chrome": "off",
    "claude-api": "user-invocable-only",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "find-skills": "off",
    "refactor": "off",
    "improve-codebase-architecture": "off",
    "writing-guidelines": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

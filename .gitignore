# Build artifacts
/target
**/*.rs.bk
*.pdb

# Runtime-generated game data (not source)
/save.bin
/saves/
/run_history.log
/profile.ron
# The arena's default report path — a measurement, not source. Scenarios in
# `dev-arenas/` are checked in; what one run of them said is not.
/arena-report.ron
# Battle telemetry, written only under `FERAL_DEV_LOG`. The log is a
# measurement; `dev-logs/README.md` is the schema and stays checked in.
/dev-logs/*.jsonl
# `train --log-dir`'s output. Hundreds of megabytes of JSONL per sweep, and
# regenerable from the seed — but the `-report.ron` and weight files beside
# them are small and *are* the record of what a sweep found, so they stay.
/dev-logs/policy-sweep/*.jsonl

# The analysis venv and whatever it plots. `requirements.txt` is the record
# of what it needs; the tree itself and its charts are regenerable.
/analysis/.venv/
/analysis/out/
__pycache__/
.pytest_cache/

# Agent worktrees. `.claude/settings.json` is project config and stays
# tracked; a worktree gitlink is another session's checkout state and was
# committed here once by accident.
/.claude/worktrees/

# Editor/IDE
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store

# AI assistant tooling/config (local, not shared project content)
CLAUDE.md
AGENTS.md
.junie/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
.superpowers/
.claude/settings.local.json
repo-hotspots.md

# The tuner writes proposals here; a proposal is a measurement, not source.
/dev-tuning/out/

(
    id: "hard_fault",
    name: "Hard Fault Everyone",
    // Exclusive: the Overseer's. A two-round stun across every hostile in
    // the fight is the single strongest tempo swing in the game, which is
    // why it is priced at a five-round cooldown and why nobody can write
    // one — Hard Lock Everyone, the ordinary routine nearest this, is a
    // debuff without the duration.
    description: "Fault every hostile process at once — two rounds of nothing",
    target: AllEnemies,
    effect: Debuff(kind: Stun, power: 0, duration: 2),
    cooldown: 5,
    power_cost: 20.0,
    exclusive: true,
    boss_drop: Some([("overseer", 0.30)]),
)

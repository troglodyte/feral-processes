(
    id: "long_winter",
    name: "Long Winter Party",
    // Exclusive: the Overseer's. Ablative Layer Single is -10% to one ally
    // for 80 turns; this is a quarter off the whole party for the length of
    // a Stack descent. The Power cost is the real price — at 40 it is most
    // of a full charge, so this is cast at the top of a run and lived with.
    description: "-25% incoming damage to the whole party, and it lasts",
    target: WholeParty,
    power_cost: 40.0,
    effect: FieldBuff(kind: Mitigation, power: 25, duration: 300),
    exclusive: true,
    boss_drop: Some([("overseer", 0.35)]),
)

(
    id: "long_winter",
    name: "Long Winter Party",
    // Exclusive: the Overseer's. Both Mitigation routines now run until the
    // party rests, so length is no longer what separates them — Ablative
    // Layer Single is -10% to one ally, this is a quarter off everyone. The
    // Power cost is the whole price and it is a steep one: at 40 it is most
    // of a full charge, so this is cast at the top of a run and lived with.
    description: "-25% incoming damage to the whole party until you rest",
    target: WholeParty,
    power_cost: 40.0,
    effect: FieldBuff(kind: Mitigation, power: 25),
    exclusive: true,
    boss_drop: Some([("overseer", 0.35)]),
)

(
    id: "entropy",
    name: "Entropy",
    legacy: "Luck",
    short: "carries accumulated noise",
    meaning: "How much accumulated noise this program runs with — the drift that collects in anything left running long enough. A high-Entropy program is one whose edges have gone soft in ways nobody deliberately wrote.",
    base: 40,
    spread: 15,
    effects: [(stat: Crit, per_point: 0.002), (stat: Fumble, per_point: 0.001), (stat: Perception, per_point: 0.033)],
    does: "Each point above the baseline adds 0.2% to your crit chance and 0.1% to your fumble chance, and a sliver of how far you see on the surface.",
)

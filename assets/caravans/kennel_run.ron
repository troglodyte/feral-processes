(
    id: "kennel_run",
    name: "Kennel Run",
    description: "A handler and a string of programs on short leashes, walking them somewhere that pays better. Everything here has been someone else's already.",
    glyph: 'Ω',
    color: DarkGreen,
    rows: 10,
    // Program-weighted, so which trader is standing there is visibly a
    // different shelf rather than a reroll of one table.
    weights: (
        gear: 1,
        routines: 3,
        programs: 6,
        materials: 0,
    ),
    // Lower than the Salvage Convoy's, and on a shelf that is mostly
    // programs anyway: what this one is for is the leashes, and its one or
    // two racks of gear are a sideline rather than the pitch.
    bonus_share: 20,
    min_zone: 2,
    max_zone: 99,
)

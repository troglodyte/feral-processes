(
    id: "salvage_convoy",
    name: "Salvage Convoy",
    description: "Three carts of other people's gear, sorted by whoever got there first. They don't ask where anything came from and they'd rather you didn't either.",
    glyph: 'Ω',
    color: DarkGreen,
    rows: 50,
    // Gear-weighted: what this one is for is a shelf of worn equipment you
    // cannot compile yet. Materials are the filler.
    weights: (
        gear: 6,
        routines: 2,
        programs: 0,
        materials: 2,
    ),
    // What this wagon trades on. A gear-weighted trader whose every row is
    // a drop-rate roll is a rack of ordinary junk, so better than a third
    // of its equipment is standout stock — the reason to walk over and
    // look rather than to check the price and leave.
    bonus_share: 35,
    min_zone: 1,
    max_zone: 99,
)

(
    id: "gossip",
    name: "Gossip",
    // Ignored: the hearsay def comes from the speaker's own memory's `spreads_as`.
    listener_memory: "chatted_with",
    weight: 1.0,
    sulking: 1.5,
    by_band: {Enemy: 1.0, Rival: 1.0, Neutral: 1.0, Friend: 1.3, Close: 1.5},
    by_disposition: {Amiable: 1.2},
    gossip: true,
    exchanges: [
        [
            (by: Speaker, text: "Heard something on {topic}."),
            (by: Listener, text: "Transmit."),
            (by: Speaker, text: "Transmitted."),
        ],
        [
            (by: Speaker, text: "{topic}. Do not repeat this."),
            (by: Listener, text: "Stored, {speaker}."),
        ],
        [
            (by: Speaker, text: "Data on {topic}, {listener}."),
            (by: Listener, text: "Received."),
        ],
    ],
)

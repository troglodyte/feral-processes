(
    id: "research_data",
    name: "Research Data",
    description: "What a Research Node compiles, and what a research project runs on. It goes straight into the project the base is working rather than into your cargo.",
    value: Some(1),
    role: Some(ResearchCurrency),
    // "RD" is the derivation, and it is Routine Disk's by rights. A banked
    // currency reads fine on its initial alone.
    //
    // `banked: true` stays, but not for the reason it was written: the payout
    // is routed into the active project *ahead of* the banked branch in
    // `systems::deliver_payout`, so the flag is no longer what keeps it out of
    // a `Stock` buffer. What it still buys is `work_orders::chain_break`
    // refusing to let anyone order against it, the cargo filters that keep it
    // off every "what do I have" screen, the flat payout, and the trade
    // filters. `ItemDb::validate` also requires the `ResearchCurrency` role to
    // exist. Getting the reason right is what stops someone deleting the flag.
    abbrev: Some("R"),
    banked: true,
)

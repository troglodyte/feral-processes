(
    id: "routine_fabrication",
    name: "Routine Fabrication",
    description: "The chain of machines that makes blank Routine Disks. You need a disk to install any routine you learn. Also opens routine research, a tool that pulls a routine out of a downed program so you can keep it, and one that captures its image so you can wear it.",
    cost: 26,
    materials: [("bytecode_block", 12), ("charge_coil", 4)],
    requires: ["automation"],
    unlocks_structures: ["log_scraper", "lathe", "transcriber", "disk_press"],
    unlocks_tools: ["routine_reader", "image_capture"],
    opens_routine_tree: true,
)

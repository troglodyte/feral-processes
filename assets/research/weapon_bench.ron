(
    id: "weapon_bench",
    name: "Weapon Fabrication",
    description: "Opens the weapon and module recipes at the Workbench, and lets an Assembler turn Logic Wafers into Trace Sniffers.",
    cost: 24,
    materials: [("logic_wafer", 6), ("bytecode_block", 8)],
    // The Trace Sniffer eats Logic Wafers, which a Factory makes from Raw
    // Trace — both behind Routine Fabrication. Without it the recipe is a
    // dead end the player has no way to see coming.
    requires: ["routine_fabrication"],
    requires_subject: true,
    discoverable: true,
)

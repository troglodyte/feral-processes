(
    id: "weapon_bench",
    name: "Weapon Fabrication",
    description: "The bench where weapons and modules are made. It also turns Logic Wafers into Trace Sniffers.",
    cost: 24,
    materials: [("logic_wafer", 6), ("bytecode_block", 8)],
    // The Fabricator eats Logic Wafers, which are transcribed from Raw
    // Trace — the Transcriber and the Log Scraper, both behind Routine
    // Fabrication. Without it the bench is a dead end the player has no way
    // to see coming.
    requires: ["routine_fabrication"],
    requires_subject: true,
    unlocks_structures: ["fabricator"],
)

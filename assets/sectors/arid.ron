// An arid sector: Null Sector over most of the ground.
//
// Three deltas rather than one, because Null Sector is the one biome
// `classify` gates on a *pair* of fields: the temperature it needs comes
// down, the dryness it needs relaxes, and Mainframe's moisture floor rises
// out of the way so the wet ground it would otherwise claim falls through to
// Null Sector instead. The elevation thresholds are untouched, so this
// sector is as walkable as a neutral one.
(
    id: "arid",
    name: "Null Expanse",
    description: "Unmapped pages as far as the scan reaches.",
    shape: (
        null_temperature: -0.35,
        null_moisture: 0.35,
        mainframe_moisture: 0.35,
    ),
    palette: (
        ground_hue: 158.0,
        hazard_hue: 25.0,
    ),
)

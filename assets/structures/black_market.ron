(
    id: "market",
    name: "iso Market",
    description: "Access to net iso market.",
    glyph: '$',
    color: Yellow,
    build_cost: [("core_fragment", 16)],
    work: None,
    trade: Some((
        sell_rate: 1,
        // Buys tamed programs at a tenth of their power (max_hp + atk + def),
        // rounded down, minimum 1 Credit. Omit to deal in items only.
        program_sell_divisor: Some(10),
        // Portal Fragments are deliberately NOT on this list. Breaching is
        // earned by fighting — a 0.35 drop chance per kill, 3-6 from a boss —
        // not bought with mined salvage. Putting them back reopens the route
        // from base production straight to progression, which is the thing
        // that made settling in one zone strictly better than moving.
        // Priced by hand rather than off `ItemDef::value`: this is what the
        // trader charges, not what the thing is worth, and both are printable
        // floor-price items the player can also craft. The gap is the margin.
        buy: [
            ("ice_breaker", 5),
            ("power_cell", 3),
        ],
    )),
)

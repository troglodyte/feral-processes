(
    id: "heap_pillar",
    name: "Heap Pillar",
    description: "Claims another ring of address space for your base — the platform grows one tile in every direction, and the new mapping carries current, so the grid gains supply. Five is all the grid will hold. Permanent: a Pillar cannot be demolished, and the ground it claims takes whatever was standing on it — including a Stack link, unless it is the sector's last.",
    glyph: 'I',
    color: Cyan,
    build_cost: [("core_fragment", 24), ("blank_substrate", 6)],
    work: None,
    raidable: false,
    build_radius_bonus: 1,
    max_deployed: 5,
    power_supply: 2,
)

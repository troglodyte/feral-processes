(
    id: "line_driver",
    name: "Line Driver",
    description: "Drives the base's grid harder than a mapping alone can. Pure supply and no worker to post, but it burns a Power Cell to do it — out of its own hopper or off any buffer beside it, and the base staff fetch one from a shelf when nothing is within reach. This is what keeps a base's machines running once its Grid is stretched.",
    glyph: 'E',
    color: Yellow,
    build_cost: [("core_fragment", 30), ("cache_grain", 6)],
    work: None,
    power_supply: 6,
    power_upkeep: Some("power_cell"),
    max_deployed: 3,
)

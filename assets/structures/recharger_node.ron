(
    id: "recharger_node",
    name: "Recharger Node",
    description: "Trickles Power back into you every tick while you stand anywhere on your base, and separately supplies the base's Grid whether you're there or not — a different resource, same word. No worker to post, but it burns a Power Cell off an adjacent buffer to keep either half running, and goes quiet on both the moment it can't pay.",
    glyph: 'z',
    color: Orange,
    build_cost: [("core_fragment", 10)],
    work: None,
    power_regen: Some((
        per_tick: 1.0,
        radius: 10,
    )),
    power_supply: 4,
    power_upkeep: Some("power_cell"),
)

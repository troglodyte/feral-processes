(
    id: "repair_bay",
    name: "Repair Bay",
    description: "A cradle and a spool of spare instructions. A program of yours that went down in a fight walks here on its own, is written back up to full Integrity a tick at a time, and stands off the bench when it's whole. Without one, a downed program stays down. No worker, no input.",
    glyph: 'r',
    color: Green,
    build_cost: [("core_fragment", 16)],
    work: None,
    recovery: Some((
        per_tick: 1,
        radius: 0,
    )),
    power_draw: 2,
)

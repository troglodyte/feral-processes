(
    id: "component_stripper",
    name: "Component Stripper",
    description: "Pulls whole components out of a downed process instead of scrap.",
    category: Parts,
    // A plausible pool, not a tuned one: same footing as `core_tap.ron` —
    // this tool isn't the starter and isn't read by the drop-neutrality
    // test, so reweigh freely once it's actually played.
    yields: [("logic_wafer", 1.0), ("packet_buffer", 0.5)],
    tier: 1,
    ticks: 24,
    // Forged from the same low-tier salvage a Salvage Clamp already draws,
    // since a Parts tool is a lateral unlock (zone 2, same tier) rather
    // than a step up from the starter.
    forge_cost: [("core_fragment", 5)],
)

(
    id: "salvage_clamp",
    name: "Salvage Clamp",
    description: "Prises the loose material off a downed process.",
    category: Materials,
    // Task 6 checked these weights against the decision-8 drop-neutrality
    // test (`tests::extraction::the_starter_tool_is_drop_neutral_for_a_
    // median_kill`) and left them as shipped: `apportion` conserves the
    // *total* unit count under any weighting (it's a split, not a second
    // roll), so the gate is entirely `tuning::TOOL_BASE_UNITS`'s to pass or
    // fail. These weights decide only which item a unit lands in.
    yields: [("core_fragment", 1.0), ("bytecode_block", 0.4)],
    tier: 1,
    ticks: 20,
)

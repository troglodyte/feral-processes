    player: Fresh(level: 14, zone: 3),
    equip: [
        (item: "plasma_router", tier: 0),
        (item: "bastion_lattice", tier: 0),
        (item: "singularity_matrix", tier: 0),
    ],
    party: [
        (species: "scrapper", level: 8, equip: [
            (item: "arc_lance"), (item: "hardened_shell"),
        ]),
        (species: "scrapper", level: 8, equip: [
            (item: "arc_lance"), (item: "hardened_shell"),
        ]),
        (species: "scrapper", level: 8, equip: [
            (item: "arc_lance"), (item: "hardened_shell"),
        ]),
    ],
    opponents: [
        (species: "sentinel", count: 4),
        (species: "rootkit", count: 4),
    ],
    model: Tactical,
    approach: Some(East),
